{
    "group/resources": {
        "orientation": "horizontal",
        "modules": [
            "cpu",
            "memory"
        ]
    },
   "battery": {
     "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰂄{capacity}%",
    "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "format-icons": [
      "󱊡",
      "󱊢",
      "󱊣"
    ]
  },
    "cpu": {
        "format": "󰻠 {usage}%"
    },

    "memory": {
        "format": "󰍛 {percentage}%"
    }
}