{
    "layer": "top",
    "position": "top",

    "height": 40,

    "modules-left": [
        "hyprland/workspaces",
        "custom/spacer",
        "group/media"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "group/resources",
        "pulseaudio",
        "tray",
        "battery",
        "custom/notifications"
    ],

    "include": [
        "~/.config/waybar/modules/pulseaudio.jsonc",
        "~/.config/waybar/modules/clock.jsonc",
        "~/.config/waybar/modules/workspaces.jsonc",
        "~/.config/waybar/modules/groups/resources.jsonc",
        "~/.config/waybar/modules/groups/media.jsonc"
    ],


  "custom/notifications": {
    "format": "〇",
    "on-click": "pgrep swaync-client -t >/dev/null 2>&1 && killall swaync-client -t || swaync-client -t",
    "tooltip": false
  }
}