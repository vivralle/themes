{
    "$schema": "/etc/xdg/swaync/configschema.json",
    "positionX": "right",
    "positionY": "top",
    "cssPriority": "user",
    "control-center-width": 450,
    "fit-to-screen": true,

    "control-center-layer": "overlay",
    "layer-shell-cover-screen": false,

    "notification-window-width": 400,
    "notification-icon-size": 40,
    "notification-body-image-height": 500,
    "notification-body-image-width": 500,
    "notification-inline-replies": true,
    "notification-2fa-action": false,
  
  
    "keyboard-shortcuts": true,
    "image-visibility": "when-available",
    "transition-time": 200,
    "hide-on-clear": false,
    "hide-on-action": false,
    "script-fail-notify": true,

    "widgets": [
      "label",
      "mpris",
      "dnd",
      "notifications",
      "buttons-grid"
    ],
   
    "widget-config": {
        "label": {
            "text": "󰣇  Control Center"
        },

        "volume": {
            "device": "default",
            "label": "",
            "slider": false
        },

        "dnd": {
            "text": "Do not disturb"
        },

        "mpris": {
            "image-size": 100,
            "image-radius": 10,
            "autohide": false,
            "blacklist": [ "org.mpris.MediaPlayer2.playerctld"]
        },

        "buttons-grid": {
            "actions": [                
                {
                    "label": "󰆍",
                    "type": "command",
                    "command": "kitty"
                },
                {
                    "label": "󰝰",
                    "type": "command",
                    "command": "nemo"
                },
                {
                    "label": "",
                    "command": "hyprlock"
                },
                {
                    "label": "󰖔",
                    "type": "toggle",
                    "command": "pkill -x hyprsunset || hyprsunset -t 3950"
                }
            ]
        }
    }
  }
