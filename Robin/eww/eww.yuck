(include "eww_widgets.yuck")

(defwindow controlbox
  :monitor '[0]'
  :stacking "fg"
  :namespace "eww"
  :geometry (geometry
    :x "5"
    :y "6"
    :width "500"
    :height "100"
    :anchor "top left")
  (controlbox)
)

